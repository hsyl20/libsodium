cabal-version: 3.0
name:          sodium-clib
version:       1.0.20
synopsis:      Sodium is an easy-to-use software library that provides a wide range of cryptographic operations including encryption, decryption, digital signatures, and secure password hashing.
description:   libsodium. See [libsodium](https://github.com/jedisct1/libsodium)
category:      Cryptography
license:       ISC
license-file:  LICENSE
build-type:    Configure

