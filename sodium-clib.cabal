        -DHAVE_ARC4RANDOM=1
        -DHAVE_ARC4RANDOM_BUF=1
        -DHAVE_CLOCK_GETTIME=1
        -DHAVE_GETENTROPY=1
        -DHAVE_NANOSLEEP=1
        -DHAVE_POSIX_MEMALIGN=1
        -DHAVE_SYS_AUXV_H=1
        -DHAVE_SYS_PARAM_H=1
        -DHAVE_SYS_RANDOM_H=1

